# Systemd-enabled SSH node image for hypercluster local testing.
# Runs systemd as PID 1 so k3s/kubeadm services work exactly like real nodes.
# Not for production — passwordless root SSH, no hardening.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive container=docker

# Install systemd + SSH + k8s prerequisites
RUN apt-get update -qq && \
    apt-get install -y -qq \
        systemd \
        systemd-sysv \
        openssh-server \
        python3 \
        python3-pip \
        curl \
        sudo \
        iproute2 \
        iputils-ping \
        iptables \
        conntrack \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Strip systemd units that fail in containers
RUN systemctl mask \
        systemd-udevd \
        systemd-logind \
        getty.target \
        console-getty.service \
        apt-daily.service \
        apt-daily.timer \
        apt-daily-upgrade.service \
        apt-daily-upgrade.timer \
    2>/dev/null || true

# Configure sshd
RUN mkdir -p /run/sshd /root/.ssh && chmod 700 /root/.ssh && \
    sed -i \
        -e 's|#\?PermitRootLogin.*|PermitRootLogin yes|' \
        -e 's|#\?PubkeyAuthentication.*|PubkeyAuthentication yes|' \
        -e 's|#\?PasswordAuthentication.*|PasswordAuthentication no|' \
        /etc/ssh/sshd_config && \
    systemctl enable ssh

# Fix /dev/kmsg for kubelet: create a writable char device node at boot
# (bind-mounted /dev/kmsg from Podman VM may be owned by nobody — kubelet needs write)
RUN printf '[Unit]\nDescription=Fix /dev/kmsg permissions for kubelet\nDefaultDependencies=no\nBefore=k3s.service\nAfter=local-fs.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/bash -c "chmod 0666 /dev/kmsg 2>/dev/null || (mknod -m 0666 /tmp/kmsg c 1 11 && mount --bind /tmp/kmsg /dev/kmsg)"\n\n[Install]\nWantedBy=multi-user.target\n' \
    > /etc/systemd/system/fix-kmsg.service && \
    systemctl enable fix-kmsg.service

EXPOSE 22

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
