#!/bin/bash
# Block Intel Mac installs — Hypercluster Desktop is Apple Silicon (arm64) only.
# Installer may run this script under Rosetta; uname -m is then x86_64 on M-series Macs.
set -euo pipefail

is_arm64_mac() {
  [[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" == "1" ]] \
    || [[ "$(sysctl -n hw.machine 2>/dev/null || true)" == "arm64" ]]
}

if ! is_arm64_mac; then
  echo "Hypercluster Desktop requires Apple Silicon (M1/M2/M3/M4 or later)." >&2
  echo "Intel-based Mac (x86_64) is not supported as of Hypercluster 0.1.0." >&2
  echo "Install aborted." >&2
  exit 1
fi

exit 0
