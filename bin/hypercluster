#!/usr/bin/env bash
# hypercluster — npm-style CLI shim for repo root (npx hypercluster)
set -euo pipefail

if command -v realpath >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "$0")")"
else
  SCRIPT_DIR="$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")"
fi

ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
exec "${ROOT}/hypercluster" "$@"
