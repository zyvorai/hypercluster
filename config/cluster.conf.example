# hypercluster cluster configuration
# Copy to cluster.conf and edit before running.

# ---------------------------------------------------------------------------
# Cluster identity
# ---------------------------------------------------------------------------
CLUSTER_NAME="mycluster"

# ---------------------------------------------------------------------------
# Kubespray source
# ---------------------------------------------------------------------------
KUBESPRAY_VERSION="v2.30.0"
KUBESPRAY_DIR=".kubespray"          # relative to this repo root

# ---------------------------------------------------------------------------
# Kubernetes distribution
# kubespray — upstream kubeadm via Kubespray (default, HA-capable)
# k3s         — lightweight k3s over SSH + Helm platform stack from deployer
# ---------------------------------------------------------------------------
K8S_DISTRO="kubespray"              # kubespray | k3s

# k3s-only settings (ignored when K8S_DISTRO=kubespray)
K3S_DATA_DIR="/data/k3s"
K3S_VERSION=""                       # e.g. v1.35.5+k3s1 (empty = latest channel)
K3S_EXEC_ARGS="--flannel-backend=none --disable-network-policy --disable traefik --disable servicelb --disable-kube-proxy"
CILIUM_HUBBLE_ENABLED="true"
CILIUM_KUBE_PROXY_REPLACEMENT="true"
CILIUM_K8S_SERVICE_HOST="127.0.0.1"

# k3s platform stack (Helm) — auto-installed on deploy when K8S_DISTRO=k3s
PLATFORM_STACK_ENABLED="true"
CERT_MANAGER_ENABLED="true"
METALLB_ENABLED="true"
METALLB_IP_POOL=""                    # required when METALLB_ENABLED=true, e.g. "192.168.1.240-192.168.1.250"
CDI_ENABLED="true"
KUBEVIRT_CSI_ENABLED="true"
KUBEVIRT_DISKS_PROVIDER="true"
SNAPSHOT_CONTROLLER_ENABLED="true"
CNAO_ENABLED="true"
SSP_ENABLED="true"
LONGHORN_ENABLED="false"
DESCHEDULER_ENABLED="false"
NFD_ENABLED="false"
GPU_OPERATOR_ENABLED="false"

# Optional Helm chart version pins (leave empty for latest)
# CERT_MANAGER_VERSION=""
# CILIUM_CHART_VERSION=""
# METALLB_CHART_VERSION=""
# KUBEVIRT_CHART_VERSION=""
# CDI_CHART_VERSION=""

# ---------------------------------------------------------------------------
# Kubernetes (Kubespray path)
# ---------------------------------------------------------------------------
KUBE_VERSION="v1.32.0"
CONTAINER_MANAGER="podman"          # podman | containerd | docker
CNI_PLUGIN="cilium"                 # cilium | calico | flannel | kube-ovn

# Pod / service CIDRs (must not overlap with node network)
# k3s defaults: 10.42.0.0/16 pods, 10.43.0.0/16 services
KUBE_PODS_SUBNET="10.233.64.0/18"
KUBE_SERVICE_ADDRESSES="10.233.0.0/18"

# ---------------------------------------------------------------------------
# Node SSH access
# ---------------------------------------------------------------------------
SSH_USER="root"
SSH_KEY="$HOME/.ssh/id_rsa"
SSH_PORT=22                         # set to e.g. 2222 when nodes are containers with port forwarding
SSH_EXTRA_ARGS=""                   # e.g. "-o StrictHostKeyChecking=no"

# ---------------------------------------------------------------------------
# Nodes  (space-separated IPv4 addresses)
# ---------------------------------------------------------------------------
CONTROL_PLANE_IPS="192.168.1.100"
WORKER_IPS="192.168.1.101 192.168.1.102"

# ---------------------------------------------------------------------------
# Optional add-ons
# ---------------------------------------------------------------------------
METRICS_SERVER_ENABLED="true"
INGRESS_NGINX_ENABLED="false"
DASHBOARD_ENABLED="false"

# ---------------------------------------------------------------------------
# KubeVirt — VM workloads on Kubernetes
# Set to "true" to install KubeVirt operator + CDI after cluster bootstrap.
# ---------------------------------------------------------------------------
KUBEVIRT_ENABLED="true"
KUBEVIRT_VERSION="v1.3.1"          # k3s platform: v1.8.x tested on k8s v1.35.x
CDI_VERSION="v1.59.0"              # k3s platform: v1.65.x tested with KubeVirt 1.8

# ---------------------------------------------------------------------------
# kubeconfig output
# ---------------------------------------------------------------------------
KUBECONFIG_OUTPUT="$HOME/.kube/${CLUSTER_NAME}.yaml"
KUBECONFIG_MERGE_DEFAULT="false"    # merge into ~/.kube/config after deploy (k3s)
