# hypercluster cluster configuration — Kubespray HA profile
# Copy via: ./hypercluster init --profile kubespray-ha

CLUSTER_NAME="kubespray-ha"

K8S_DISTRO="kubespray"
KUBESPRAY_VERSION="v2.30.0"
KUBESPRAY_DIR=".kubespray"

KUBE_VERSION="v1.30.4"
CONTAINER_MANAGER="containerd"
CNI_PLUGIN="calico"
KUBE_PODS_SUBNET="10.233.64.0/18"
KUBE_SERVICE_ADDRESSES="10.233.0.0/18"

SSH_USER="ubuntu"
SSH_KEY="$HOME/.ssh/id_ed25519"
SSH_PORT=22
SSH_EXTRA_ARGS="-o StrictHostKeyChecking=accept-new"

CONTROL_PLANE_IPS="10.0.0.11 10.0.0.12 10.0.0.13"
WORKER_IPS="10.0.0.21 10.0.0.22"

KUBEVIRT_ENABLED="false"
METALLB_ENABLED="false"
PLATFORM_STACK_ENABLED="false"

KUBECONFIG_OUTPUT="$HOME/.kube/kubespray-ha.yaml"
KUBECONFIG_MERGE_DEFAULT="false"
