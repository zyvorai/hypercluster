#!/usr/bin/env bash
# Re-exec with Homebrew bash 5 on macOS (system bash is 3.2, missing bash 4+ features)
if [[ "$(uname)" == "Darwin" && "${BASH_VERSINFO[0]:-3}" -lt 4 ]]; then
  _b="$(brew --prefix 2>/dev/null)/bin/bash"
  [[ -x "$_b" ]] && exec "$_b" "$0" "$@"
  echo "bash 4+ required — run: brew install bash" >&2; exit 1
fi
# hypercluster — end-to-end Kubernetes cluster lifecycle wrapper for Kubespray.
#
# Usage:  hypercluster [OPTIONS] <command> [ARGS]
#
# Commands:
#   init              Clone Kubespray and generate inventory + group_vars
#                     Use init --wizard to create cluster.conf interactively first
#                     Use init --profile <name> to copy config/profiles/<name>.conf.example
#   wizard            Interactive cluster.conf generator (no existing config required)
#   preflight         Verify local tools and SSH connectivity to all nodes (--json)
#   deploy            Full cluster deployment (preflight + init + cluster.yml)
#   scale             Add worker nodes listed in cluster.conf (scale.yml)
#   upgrade           Upgrade Kubernetes to the version in cluster.conf
#   remove-node       Drain and remove a single node
#   fetch-kubeconfig  Copy admin.conf from the first control-plane node
#   merge-kubeconfig  Merge the cluster kubeconfig into ~/.kube/config
#   install-kubevirt  Install KubeVirt operator + CDI (also runs after deploy if KUBEVIRT_ENABLED=true)
#   test              Run platform smoke tests (k3s path; optional --full, --json)
#   destroy           Tear down the cluster (reset.yml or k3s uninstall)
#   vms               List KubeVirt VMs + template catalog (--json)
#   vm create         Validate template and preview VM create (--template, --name, --json)
#   workloads         List pods and services (--json)
#   discover          Discover VMs/hosts (libvirt, Proxmox, VMware, ssh-scan, csv) (--json)
#   status            Node status (optional --json for machine-readable output)
#   unlock            Remove stale per-cluster lock after a crash
#   lab setup         Secondary disk + memory tune (from cluster.conf LAB_* vars)
#   lab storage       Mount LAB_SECONDARY_DISK, patch local-path, StorageClass
#   lab tune          Scale down HA replicas on single-node labs (--restore to undo)
#
# Options:
#   -c <file>   Path to cluster config (default: ./cluster.conf)
#   -f          Force overwrite of existing inventory
#   -n          Dry run — print what would be executed, skip actual changes
#   -v          Verbose Ansible output
#   -V          Show version
#   -h          Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export HYPERCLUSTER_SCRIPT_DIR="$SCRIPT_DIR"

# ── defaults ────────────────────────────────────────────────────────────────
CONFIG_FILE="$(pwd)/cluster.conf"
FORCE=0
DRY_RUN=0
VERBOSE=0

# ── parse options ───────────────────────────────────────────────────────────
usage() {
  grep '^#' "$0" | grep -v '^#!/' | grep -v 'Re-exec' | sed 's/^# \{0,1\}//'
  exit 0
}

while getopts ":c:fnvhV" opt; do
  case "$opt" in
    c) CONFIG_FILE="$OPTARG" ;;
    f) FORCE=1 ;;
    n) DRY_RUN=1 ;;
    v) VERBOSE=1 ;;
    V) cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown"; exit 0 ;;
    h) usage ;;
    :) echo "❌  Option -$OPTARG requires an argument." >&2; exit 1 ;;
    \?) echo "❌  Unknown option: -$OPTARG" >&2; exit 1 ;;
  esac
done
shift $(( OPTIND - 1 ))

export FORCE DRY_RUN VERBOSE

COMMAND="${1:-}"
shift || true

INIT_WIZARD=0
case "$COMMAND" in
  init)
    if [[ "${1:-}" == "--wizard" ]]; then
      INIT_WIZARD=1
      shift
    fi
    ;;
esac

# ── load libraries ───────────────────────────────────────────────────────────
# shellcheck source=lib/log.sh
source "$SCRIPT_DIR/lib/log.sh"
# shellcheck source=lib/wizard.sh
source "$SCRIPT_DIR/lib/wizard.sh"
# shellcheck source=lib/progress.sh
source "$SCRIPT_DIR/lib/progress.sh"
# shellcheck source=lib/postdeploy.sh
source "$SCRIPT_DIR/lib/postdeploy.sh"
# shellcheck source=lib/preflight.sh
source "$SCRIPT_DIR/lib/preflight.sh"
# shellcheck source=lib/inventory.sh
source "$SCRIPT_DIR/lib/inventory.sh"
# shellcheck source=lib/kubespray.sh
source "$SCRIPT_DIR/lib/kubespray.sh"
# shellcheck source=lib/kubeconfig.sh
source "$SCRIPT_DIR/lib/kubeconfig.sh"
# shellcheck source=lib/k3s.sh
source "$SCRIPT_DIR/lib/k3s.sh"
# shellcheck source=lib/platform-stack.sh
source "$SCRIPT_DIR/lib/platform-stack.sh"
# shellcheck source=lib/platform-tools.sh
source "$SCRIPT_DIR/lib/platform-tools.sh"
# shellcheck source=lib/platform-test.sh
source "$SCRIPT_DIR/lib/platform-test.sh"
# shellcheck source=lib/discover.sh
source "$SCRIPT_DIR/lib/discover.sh"
# shellcheck source=lib/rke2.sh
source "$SCRIPT_DIR/lib/rke2.sh"
# shellcheck source=lib/microk8s.sh
source "$SCRIPT_DIR/lib/microk8s.sh"
# shellcheck source=lib/talos.sh
source "$SCRIPT_DIR/lib/talos.sh"
# shellcheck source=lib/vms.sh
source "$SCRIPT_DIR/lib/vms.sh"
# shellcheck source=lib/workloads.sh
source "$SCRIPT_DIR/lib/workloads.sh"
# shellcheck source=lib/lab.sh
source "$SCRIPT_DIR/lib/lab.sh"

# ── discover (no cluster.conf required) ───────────────────────────────────────
if [[ "$COMMAND" == "discover" ]]; then
  discover::run "$@"
  exit $?
fi

# ── wizard (no cluster.conf required) ─────────────────────────────────────────
if [[ "$COMMAND" == "wizard" ]]; then
  wizard::write_config "$CONFIG_FILE"
  exit 0
fi

if [[ "$INIT_WIZARD" == "1" ]]; then
  wizard::write_config "$CONFIG_FILE"
fi

# ── load cluster config ──────────────────────────────────────────────────────
if [[ ! -f "$CONFIG_FILE" ]]; then
  die "Config file not found: $CONFIG_FILE
       Run: ./hypercluster wizard
       Or:  ./hypercluster init --wizard
       Or:  cp config/cluster.conf.example cluster.conf"
fi
# shellcheck source=/dev/null
source "$CONFIG_FILE"

# Validate required config variables
_distro="${K8S_DISTRO:-kubespray}"
# kubeadm maps to Kubespray path
[[ "$_distro" == "kubeadm" ]] && K8S_DISTRO="kubespray" && _distro="kubespray"
_required_vars=(CLUSTER_NAME SSH_USER SSH_KEY CONTROL_PLANE_IPS)
if [[ "$_distro" == "kubespray" ]]; then
  _required_vars+=(KUBESPRAY_VERSION KUBE_VERSION)
fi
if [[ "$_distro" == "talos" ]]; then
  _required_vars=(CLUSTER_NAME CONTROL_PLANE_IPS)
fi
_missing=()
for _v in "${_required_vars[@]}"; do
  [[ -n "${!_v:-}" ]] || _missing+=("$_v")
done
if [[ "${#_missing[@]}" -gt 0 ]]; then
  die "Missing required variables in $CONFIG_FILE: ${_missing[*]}"
fi
unset _required_vars _missing _v

# ── lock helpers ─────────────────────────────────────────────────────────────
_lock_dir_for_cluster() {
  echo "/tmp/hypercluster-${1}.lock"
}

_acquire_lock() {
  local lock_dir pid_file
  lock_dir="$(_lock_dir_for_cluster "$CLUSTER_NAME")"
  pid_file="$lock_dir/pid"

  if [[ -d "$lock_dir" ]]; then
    if [[ -f "$pid_file" ]]; then
      local old_pid
      old_pid=$(cat "$pid_file" 2>/dev/null || echo "")
      if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
        die "Another hypercluster instance is already running for cluster '$CLUSTER_NAME' (PID $old_pid).
       Lock dir: $lock_dir — use 'hypercluster unlock' if the previous run crashed."
      fi
      log::warn "Removing stale lock for cluster '$CLUSTER_NAME' (PID $old_pid not running)."
      rm -rf "$lock_dir"
    else
      die "Lock dir exists without PID file: $lock_dir
       Remove it manually or run 'hypercluster unlock'."
    fi
  fi

  if ! mkdir "$lock_dir" 2>/dev/null; then
    die "Could not acquire lock for cluster '$CLUSTER_NAME' ($lock_dir)."
  fi
  echo "$$" > "$pid_file"
  _LOCK_DIR="$lock_dir"
  trap '_release_lock' EXIT INT TERM
}

_release_lock() {
  [[ -n "${_LOCK_DIR:-}" ]] && rm -rf "$_LOCK_DIR" 2>/dev/null || true
}

cmd_unlock() {
  local lock_dir
  lock_dir="$(_lock_dir_for_cluster "$CLUSTER_NAME")"
  if [[ ! -d "$lock_dir" ]]; then
    log::info "No lock found for cluster '$CLUSTER_NAME'."
    return 0
  fi
  rm -rf "$lock_dir"
  log::ok "Lock removed for cluster '$CLUSTER_NAME'."
}

# unlock skips lock acquisition
if [[ "$COMMAND" == "unlock" ]]; then
  _SKIP_LOCK=1
fi

if [[ "${_SKIP_LOCK:-0}" != "1" ]]; then
  _acquire_lock
fi

# Resolve KUBESPRAY_DIR: absolute paths pass through, relative paths are anchored to SCRIPT_DIR
_raw_ks="${KUBESPRAY_DIR:-.kubespray}"
if [[ "$_raw_ks" == /* ]]; then
  KUBESPRAY_DIR="$_raw_ks"
else
  KUBESPRAY_DIR="$SCRIPT_DIR/$_raw_ks"
fi
unset _raw_ks
INV_DIR="$KUBESPRAY_DIR/inventory/$CLUSTER_NAME"

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {
  local profile=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        profile="${2:-}"
        shift 2
        ;;
      --profile=*)
        profile="${1#*=}"
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
  if [[ -n "$profile" ]]; then
    local tpl="${SCRIPT_DIR}/config/profiles/${profile}.conf.example"
    [[ -f "$tpl" ]] || die "Unknown profile: $profile (expected $tpl)"
    cp "$tpl" "$CLUSTER_CONF"
    log::ok "Copied profile $profile → $CLUSTER_CONF"
    # shellcheck source=/dev/null
    source "$CLUSTER_CONF"
  fi
  if [[ "${K8S_DISTRO:-kubespray}" == "k3s" || "${K8S_DISTRO:-}" == "rke2" || "${K8S_DISTRO:-}" == "microk8s" || "${K8S_DISTRO:-}" == "talos" ]]; then
    log::section "Init: ${K8S_DISTRO} (no Kubespray inventory)"
    log::ok "${K8S_DISTRO} mode — config validated, ready to deploy."
    return 0
  fi
  log::section "Init: Kubespray source + inventory"
  kubespray::ensure_source "$KUBESPRAY_DIR" "$KUBESPRAY_VERSION"
  inventory::init "$KUBESPRAY_DIR"
}

cmd_preflight() {
  local json=0
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
    esac
  done
  if [[ "$json" == "1" ]]; then
    HC_JSON=1 preflight::run
    return $?
  fi
  preflight::run
}

cmd_deploy() {
  log::section "Deploy cluster: $CLUSTER_NAME (${K8S_DISTRO:-kubespray})"

  if [[ "${K8S_DISTRO:-kubespray}" == "k3s" ]]; then
    progress::stage 1 7 "Preflight checks"
    cmd_preflight
    progress::stage 2 7 "Init — validate k3s config"
    cmd_init
    progress::stage 3 7 "k3s install (server + workers, no Flannel/Traefik)"
    k3s::deploy
    progress::stage 4 7 "Fetch kubeconfig (laptop + remote user)"
    cmd_fetch_kubeconfig
    k3s::wait_api
    k3s::install_remote_kubeconfig
    progress::stage 5 7 "Platform stack (Cilium, MetalLB, KubeVirt, CDI, …)"
    [[ "${PLATFORM_STACK_ENABLED:-true}" == "true" ]] && platform::install_stack
    progress::stage 6 7 "Remote CLI tools + kubeconfig merge"
    platform_tools::install_remote
    platform_tools::merge_laptop_kubeconfig
    progress::stage 7 7 "Done"
    log::ok "k3s virtualization platform deployed! 🎉"
    if [[ "${LAB_AUTO_SETUP:-false}" == "true" ]]; then
      lab::setup
    fi
    postdeploy::print_hints
    return 0
  fi

  if [[ "${K8S_DISTRO:-}" == "rke2" ]]; then
    progress::stage 1 5 "Preflight checks"
    cmd_preflight
    progress::stage 2 5 "RKE2 install (servers + agents)"
    rke2::deploy
    progress::stage 3 5 "Fetch kubeconfig"
    rke2::fetch_kubeconfig
    progress::stage 4 5 "Platform stack (optional)"
    [[ "${PLATFORM_STACK_ENABLED:-false}" == "true" ]] && platform::install_stack
    progress::stage 5 5 "Done"
    log::ok "RKE2 cluster deployed! 🎉"
    postdeploy::print_hints
    return 0
  fi

  if [[ "${K8S_DISTRO:-}" == "microk8s" ]]; then
    progress::stage 1 4 "Preflight checks"
    cmd_preflight
    progress::stage 2 4 "MicroK8s snap install + join"
    microk8s::deploy
    progress::stage 3 4 "Fetch kubeconfig"
    microk8s::fetch_kubeconfig
    progress::stage 4 4 "Done"
    log::ok "MicroK8s cluster deployed! 🎉"
    postdeploy::print_hints
    return 0
  fi

  if [[ "${K8S_DISTRO:-}" == "talos" ]]; then
    talos::deploy
  fi

  progress::stage 1 4 "Preflight checks"
  cmd_preflight
  progress::stage 2 4 "Init — Kubespray + inventory"
  cmd_init
  progress::stage 3 4 "Kubespray cluster.yml (typically 15–30 min)"
  kubespray::run_playbook "$KUBESPRAY_DIR" cluster.yml
  log::ok "Cluster deployed! 🎉"
  progress::stage 4 4 "Fetch kubeconfig + optional add-ons"
  cmd_fetch_kubeconfig
  [[ "${KUBEVIRT_ENABLED:-false}" == "true" ]] && cmd_install_kubevirt
  postdeploy::print_hints
}

cmd_install_kubevirt() {
  log::section "Installing KubeVirt"
  local kc="${KUBECONFIG_OUTPUT/#\~/$HOME}"
  local required="${KUBEVIRT_REQUIRED:-false}"
  if [[ "${KUBEVIRT_ENABLED:-false}" == "true" ]]; then
    required="true"
  fi
  if [[ ! -f "$kc" ]]; then
    if [[ "$required" == "true" ]]; then
      die "kubeconfig not found at $kc — cannot install KubeVirt.
       Run 'fetch-kubeconfig' first, or set KUBEVIRT_ENABLED=false to skip."
    fi
    log::warn "kubeconfig not found at $kc — skipping KubeVirt install."
    return 0
  fi
  local kv_ver="${KUBEVIRT_VERSION:-v1.3.1}"
  local cdi_ver="${CDI_VERSION:-v1.59.0}"
  local base="https://github.com/kubevirt/kubevirt/releases/download/$kv_ver"
  log::info "Deploying KubeVirt operator $kv_ver …"
  KUBECONFIG="$kc" kubectl apply -f "$base/kubevirt-operator.yaml"
  KUBECONFIG="$kc" kubectl apply -f "$base/kubevirt-cr.yaml"
  log::info "Waiting for KubeVirt to be ready (up to 10 min) …"
  KUBECONFIG="$kc" kubectl -n kubevirt wait kubevirt kubevirt \
    --for=condition=Available --timeout=600s
  log::info "Deploying CDI $cdi_ver …"
  local cdi_base="https://github.com/kubevirt/containerized-data-importer/releases/download/$cdi_ver"
  KUBECONFIG="$kc" kubectl apply -f "$cdi_base/cdi-operator.yaml"
  KUBECONFIG="$kc" kubectl apply -f "$cdi_base/cdi-cr.yaml"
  KUBECONFIG="$kc" kubectl -n cdi wait cdi cdi \
    --for=condition=Available --timeout=300s
  log::ok "KubeVirt $kv_ver + CDI $cdi_ver installed ✅"
}

cmd_scale() {
  log::section "Scale cluster: $CLUSTER_NAME"
  [[ -d "$INV_DIR" ]] || die "Inventory not found. Run 'init' first."
  inventory::generate_hosts_yaml "$INV_DIR"
  inventory::generate_group_vars "$INV_DIR"
  kubespray::run_playbook "$KUBESPRAY_DIR" scale.yml
  log::ok "Scale complete ✅"
}

cmd_upgrade() {
  log::section "Upgrade cluster → $KUBE_VERSION"
  [[ -d "$INV_DIR" ]] || die "Inventory not found. Run 'init' first."
  kubespray::run_playbook "$KUBESPRAY_DIR" upgrade_cluster.yml
  log::ok "Upgrade complete ✅"
}

cmd_remove_node() {
  local node="${1:-}"
  [[ -n "$node" ]] || die "Usage: hypercluster remove-node <node-name>"
  log::section "Remove node: $node"
  local extra_vars=("-e" "node=$node" "-e" "reset_nodes=true")
  if [[ "${FORCE:-0}" == "1" ]]; then
    log::warn "Forcing ungraceful removal (--force)."
    extra_vars+=("-e" "allow_ungraceful_removal=true")
  fi
  kubespray::run_playbook "$KUBESPRAY_DIR" remove_node.yml "${extra_vars[@]}"
  log::ok "Node $node removed ✅"
}

cmd_fetch_kubeconfig() {
  kubeconfig::fetch "$KUBESPRAY_DIR"
}

cmd_merge_kubeconfig() {
  kubeconfig::merge_into_default
}

cmd_destroy() {
  log::section "⚠️  DESTROY cluster: $CLUSTER_NAME"
  if [[ "${FORCE:-0}" != "1" ]]; then
    read -r -p "Type the cluster name to confirm destruction ($CLUSTER_NAME): " confirm
    [[ "$confirm" == "$CLUSTER_NAME" ]] || die "Aborted."
  fi
  if [[ "${K8S_DISTRO:-kubespray}" == "k3s" ]]; then
    k3s::destroy
    log::ok "k3s cluster destroyed."
    return 0
  fi
  kubespray::run_playbook "$KUBESPRAY_DIR" reset.yml -e "reset_confirmation=yes"
  log::ok "Cluster destroyed."
}

cmd_status() {
  local json=0
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
    esac
  done
  local kc="${KUBECONFIG_OUTPUT/#\~/$HOME}"
  if [[ ! -f "$kc" ]]; then
    local artifacts_kc="$INV_DIR/artifacts/admin.conf"
    if [[ -f "$artifacts_kc" ]]; then
      log::warn "kubeconfig not found at $kc — falling back to artifacts copy."
      kc="$artifacts_kc"
    else
      die "kubeconfig not found: $kc — run 'fetch-kubeconfig' first."
    fi
  fi
  if [[ "$json" == "1" ]]; then
    KUBECONFIG="$kc" kubectl get nodes -o json | python3 -c '
import json, sys
data = json.load(sys.stdin)
nodes = []
ready = 0
for item in data.get("items", []):
    name = item["metadata"]["name"]
    conds = item.get("status", {}).get("conditions", [])
    is_ready = any(c.get("type") == "Ready" and c.get("status") == "True" for c in conds)
    if is_ready:
        ready += 1
    roles = item["metadata"].get("labels", {}).get("node-role.kubernetes.io/control-plane", "")
    nodes.append({"name": name, "ready": is_ready, "roles": roles or "worker"})
print(json.dumps({"ready": ready, "total": len(nodes), "nodes": nodes}))
'
    return 0
  fi
  log::section "Cluster status: $CLUSTER_NAME"
  KUBECONFIG="$kc" kubectl get nodes -o wide
}

cmd_test() {
  if [[ "${K8S_DISTRO:-kubespray}" != "k3s" ]]; then
    die "test command is for K8S_DISTRO=k3s only. Use kubectl checks for Kubespray clusters."
  fi
  local json=0 full=""
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
      --full) full="--full" ;;
    esac
  done
  if [[ "$json" == "1" ]]; then
    HC_JSON=1 platform_test::run "$full"
    return $?
  fi
  platform_test::run "$full"
}

cmd_vms() {
  local json=0
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
    esac
  done
  if [[ "$json" == "1" ]]; then
    vms::list_json
    return $?
  fi
  log::section "KubeVirt VMs: $CLUSTER_NAME"
  vms::list_json | python3 -c '
import json, sys
d = json.load(sys.stdin)
for vm in d.get("vms", []):
    ns = vm.get("namespace", "default")
    name = vm.get("name", "?")
    phase = vm.get("phase", "?")
    ip = vm.get("ip", "")
    print(f"{ns}/{name}  {phase}  {ip}")
if not d.get("vms"):
    print("(no running VMIs — enable KubeVirt and create VMs)")
'
}

cmd_vm_create() {
  local json=0 template="" name="" namespace="default"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --template) template="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --namespace) namespace="$2"; shift 2 ;;
      *) log::error "Unknown arg: $1"; return 1 ;;
    esac
  done
  if [[ "$json" == "1" ]]; then
    vms::create_json "$template" "$name" "$namespace"
    return $?
  fi
  vms::create_json "$template" "$name" "$namespace" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d.get("message", d))
'
}

cmd_vm() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    create) cmd_vm_create "$@" ;;
    *)
      log::error "Usage: hypercluster vm create --template <id> --name <name> [--namespace ns] [--json]"
      return 1
      ;;
  esac
}

cmd_lab() {
  if [[ "${K8S_DISTRO:-kubespray}" != "k3s" ]]; then
    die "lab command is for K8S_DISTRO=k3s only."
  fi
  lab::run "$@"
}

cmd_workloads() {
  local json=0
  for arg in "$@"; do
    case "$arg" in
      --json) json=1 ;;
    esac
  done
  if [[ "$json" == "1" ]]; then
    workloads::json
    return $?
  fi
  log::section "Workloads: $CLUSTER_NAME"
  workloads::json | python3 -c '
import json, sys
d = json.load(sys.stdin)
pods = d.get("pods", [])
svcs = d.get("services", [])
print(f"Pods: {len(pods)}  Services: {len(svcs)}")
for p in pods[:20]:
    print(f"{p['namespace']}/{p['name']}  {p['phase']}")
if len(pods) > 20:
    print(f"... and {len(pods) - 20} more pods")
'
}

# ── dispatch ─────────────────────────────────────────────────────────────────
case "$COMMAND" in
  init)               cmd_init "$@" ;;
  preflight)          cmd_preflight ;;
  deploy)             cmd_deploy ;;
  scale)              cmd_scale ;;
  upgrade)            cmd_upgrade ;;
  remove-node)        cmd_remove_node "${1:-}" ;;
  fetch-kubeconfig)   cmd_fetch_kubeconfig ;;
  merge-kubeconfig)   cmd_merge_kubeconfig ;;
  install-kubevirt)   KUBEVIRT_REQUIRED=1; cmd_install_kubevirt ;;
  test)               cmd_test "$@" ;;
  destroy)            cmd_destroy ;;
  status)             cmd_status "$@" ;;
  vms)                cmd_vms "$@" ;;
  vm)                 cmd_vm "$@" ;;
  workloads)          cmd_workloads "$@" ;;
  lab)                cmd_lab "$@" ;;
  unlock)             cmd_unlock ;;
  wizard)             ;; # handled before config load
  "")                 usage ;;
  *)                  log::error "Unknown command: $COMMAND"; echo; usage ;;
esac
