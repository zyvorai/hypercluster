<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Hypercluster</title>
    <organization>dev.hypercluster</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <license file="EULA.rtf"/>
    <welcome file="Welcome.html"/>
    <conclusion file="Conclusion.html"/>
    <choices-outline>
        <line choice="default">
            <line choice="dev.hypercluster.desktop"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.hypercluster.desktop" visible="false">
        <pkg-ref id="dev.hypercluster.desktop"/>
    </choice>
    <pkg-ref id="dev.hypercluster.desktop" version="0.1.0" onConclusion="none">Hypercluster-component.pkg</pkg-ref>
</installer-gui-script>
