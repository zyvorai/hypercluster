{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hypercluster",
  "version": "0.1.0",
  "identifier": "dev.hypercluster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hypercluster",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 ZyvorAI Labs Private Limited",
    "category": "DeveloperTool",
    "shortDescription": "Kubernetes cluster lifecycle desktop for hypercluster",
    "longDescription": "Hypercluster Desktop — Liquid Glass UI for k3s and Kubespray. Proprietary software by ZyvorAI Labs (zyvor.dev).",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "resources": [
      "../distribution/HYPERCLUSTER-EULA.txt"
    ]
  }
}
